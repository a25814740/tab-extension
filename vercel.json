{
  "buildCommand": "pnpm --filter @toby/newtab build:preview && pnpm --filter @toby/creator build",
  "outputDirectory": "docs",
  "redirects": [
    { "source": "/creator", "destination": "/creator/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/creator/:path*", "destination": "/creator/index.html" },
    { "source": "/preview", "destination": "/preview/preview/index.html" },
    { "source": "/preview/", "destination": "/preview/preview/index.html" },
    { "source": "/preview/:path*", "destination": "/preview/preview/index.html" }
  ]
}
