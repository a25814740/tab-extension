{
  "buildCommand": "pnpm --filter @toby/newtab build:preview && pnpm --filter @toby/creator build",
  "outputDirectory": "docs",
  "redirects": [
    { "source": "/creator", "destination": "/creator/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/creator/(.*)", "destination": "/creator/index.html" }
  ]
}
